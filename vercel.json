{
  "buildCommand": "vite build && node scripts/generate-seo-html.mjs",
  "outputDirectory": "dist",
  "alias": [
    "jubafashionhub.link",
    "admin.jubafashionhub.link"
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "images": {
    "sizes": [96, 160, 320, 480, 640, 960, 1200],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "localPatterns": [{ "pathname": "^/images/.*$" }],
    "remotePatterns": [
      { "protocol": "https", "hostname": "^firebasestorage\\.googleapis\\.com$", "pathname": "^/v0/b/.*$" },
      { "protocol": "https", "hostname": "^www\\.lattafa-usa\\.com$", "pathname": "^/.*$" }
    ]
  },
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" }
      ]
    }
  ],
  "redirects": [
    { "source": "/collection/:path*", "destination": "/collections/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
